<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Ranges are published as the package's dependency ranges; NuGet restores the lowest version
       in each, so the package is compiled against the oldest version it claims to support.
       Umbraco.Cms.Core is the direct dependency the Umbraco Marketplace reads for compatibility.
       18.1.0 is the minimum Umbraco.Automate 18.5 itself requires. -->
  <ItemGroup>
    <PackageVersion Include="Umbraco.Cms.Core" Version="[18.1.0, 19.0.0)" />
    <PackageVersion Include="Umbraco.Automate.Core" Version="[18.5.0, 19.0.0)" />
    <PackageVersion Include="Umbraco.Automate.Web" Version="[18.5.0, 19.0.0)" />
  </ItemGroup>

  <!-- Build-time only. -->
  <ItemGroup>
    <PackageVersion Include="MinVer" Version="6.0.0" />
  </ItemGroup>
</Project>
