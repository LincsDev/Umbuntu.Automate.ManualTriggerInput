<?xml version="1.0" encoding="utf-8"?>
<!-- Restore from nuget.org only, regardless of machine-level sources, so local and CI builds
     resolve identically. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
